{% load static %}{% autoescape off %}{
  "id": "/",
  "name": "ARAI GO GU - พี่ริว AI ติวเตอร์ภาษา",
  "short_name": "พี่ริว",
  "description": "เรียนภาษาด้วยการแชทกับพี่ริว AI ติวเตอร์ ตรวจไวยากรณ์ ฝึกบทสนทนา เตรียมสอบ ทดลองฟรีวันละ {{ guest_limit }} ข้อความ",
  "lang": "th",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {"src": "{% static 'img/icons/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "{% static 'img/icons/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "{% static 'img/icons/maskable-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "{% static 'img/icons/maskable-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "แชทใหม่", "short_name": "แชทใหม่", "url": "/?source=shortcut", "icons": [{"src": "{% static 'img/icons/shortcut-96.png' %}", "sizes": "96x96", "type": "image/png"}]},
    {"name": "ตรวจไวยากรณ์", "short_name": "ตรวจแกรมม่า", "url": "/?topic=grammar", "icons": [{"src": "{% static 'img/icons/shortcut-96.png' %}", "sizes": "96x96", "type": "image/png"}]},
    {"name": "ความก้าวหน้า", "short_name": "ความก้าวหน้า", "url": "/dashboard/", "icons": [{"src": "{% static 'img/icons/shortcut-96.png' %}", "sizes": "96x96", "type": "image/png"}]},
    {"name": "ชุมชน", "short_name": "ชุมชน", "url": "/community/", "icons": [{"src": "{% static 'img/icons/shortcut-96.png' %}", "sizes": "96x96", "type": "image/png"}]}
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {"title": "title", "text": "text", "url": "url"}
  }
}
{% endautoescape %}
