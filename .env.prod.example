# Copy to .env.prod on the SERVER and fill every value. Never commit.
DOMAIN=example.com
# SITE_URL defaults to https://$DOMAIN (canonical URLs, sitemap, llms.txt). GUEST_DAILY_CHAT_LIMIT=10
DJANGO_SECRET_KEY=change-me
DB_NAME=araigogu
DB_USER=araigogu
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
AI_INTERNAL_TOKEN=change-me
# AI providers: fill at least one. Images need GEMINI (or OPENAI as fallback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_CHAT_LIMIT=100
# Password-reset e-mail (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Arai Go Gu <noreply@example.com>
