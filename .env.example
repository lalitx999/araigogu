# Copy to .env and fill in.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=araigogu
DB_USER=araigogu
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# Shared secret between web (Django) and ai-service (FastAPI)
AI_INTERNAL_TOKEN=change-me
AI_SERVICE_URL=http://ai-service:8001

# Leave empty to run ai-service in fallback mode (canned replies). Use a NEW key, not the old one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
