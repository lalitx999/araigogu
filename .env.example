# Copy to .env and fill in.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=araigogu
DB_USER=araigogu
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# Shared secret between web (Django) and ai-service (FastAPI)
AI_INTERNAL_TOKEN=change-me
AI_SERVICE_URL=http://ai-service:8001

# AI Service Providers (Leave empty to run in fallback mode)
# 1. Google Gemini (Recommended for Vision & Homework checking)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq (Ultra-fast chat inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. DeepSeek (Deep reasoning & grammar)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 4. OpenAI (Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
